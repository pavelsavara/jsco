{
  "version": "1.0.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "jsco: AppBundle WasmTestRunner 2",
      "sourceMaps": true,
      "showAsyncStacks": true,
      "smartStep": true,
      "sourceMapPathOverrides": {
        "file:///*": "*"
      },
      "runtimeArgs": [
        "--experimental-wasm-jspi"
      ],
      "program": "${workspaceFolder}/dist/debug/cli.js",
      "args": [
        "run",
        "--dir",
        "D:\\runtime2\\artifacts\\bin\\System.Net.Http.Functional.Tests\\Debug\\net11.0-wasi\\wasi-wasm\\AppBundle\\::/",
        "--cwd",
        "/",
        "--env=MONO_LOG_LEVEL=debug",
        "--env=MONO_LOG_MASK=all",
        "D:\\runtime2\\artifacts\\bin\\System.Net.Http.Functional.Tests\\Debug\\net11.0-wasi\\wasi-wasm\\AppBundle\\dotnet.wasm",
        "--",
        "WasmTestRunner",
        "managed/System.Net.Http.Functional.Tests.dll",
        "-notrait",
        "category=OuterLoop",
        "-notrait",
        "category=failing"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "jsco: Browser AppBundle WasmTestRunner 2",
      "url": "http://127.0.0.1:8080/runtime2/artifacts/bin/System.Net.Http.Functional.Tests/Release/net11.0-wasi/wasi-wasm/AppBundle/index.html",
      "webRoot": "D:/",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "file:///*": "*"
      },
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
  ]
}